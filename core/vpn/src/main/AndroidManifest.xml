<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: mỗi foreground service phải khai báo loại + quyền tương ứng. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          BIND_VPN_SERVICE: chỉ hệ thống mới bind được vào service này.
          Intent-filter android.net.VpnService: cần để hỗ trợ "Always-on VPN" trong Settings.
        -->
        <service
            android:name=".AdBlockVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS-filtering VPN that blocks ad and tracker domains" />
        </service>
    </application>
</manifest>
